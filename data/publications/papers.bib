% Lab publications, shown on the Publications page. How to add one: README.md.
%
% Headings: is_preprint papers first, then one per `year` (newest first), then
% is_previous papers. Within a heading, papers keep the order written here; the
% "% =====" lines below are only for reading.
%
% Every field of an entry:
%
% @inproceedings{jang26hidden,          key: first author's last name + yy + first title word
%   title        = {...},               required. \& for &
%   author       = {@hyeondojang and @kwanheelee and Dan Alistarh},
%                                       required. Lab people as @tag (members.yaml), others by
%                                       name; * after a name marks equal contribution
%   venue        = {EMNLP 2026},        required. As printed
%   year         = {2026},              required. Sets the year heading
%   oral         = {true},              optional. Adds "(Oral)" after the venue
%   spotlight    = {true},              optional. Adds "(Spotlight)" after the venue
%   also         = {ICLR 2023 Workshop on ...},   optional. Another venue of the same paper
%   award        = {CKAIA 2026 Best Paper Award}, optional. Highlighted at the end
%   is_preprint  = {true},              optional. Under "Preprint"
%   is_previous  = {true},              optional. Under "Previous" (work before the lab)
%   spaced_links = {true},              optional. Space between this paper's links
%
%   Links: any other field is a link, shown with the field name as its label, in the
%   order written. News links [text](@key) go to `paper`. Labels in use:
%   paper        = {https://...},       the paper itself (arXiv, OpenReview, journal, ...)
%   code         = {https://...},       code repository
%   code-torch   = {https://...},       code, PyTorch version  (lee25safe)
%   code-jax     = {https://...},       code, JAX version      (lee25safe)
%   model        = {https://...},       released models        (lee26hardware)
%   OpenReview   = {https://...},       OpenReview page, when `paper` is elsewhere (nam23almost)
% }

