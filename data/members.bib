% Lab members — the source of truth for the lists on group.html, and for the
% member faces on the news and publication pages.
%
% @member{<photo file name>,       the key is also the card's anchor: group.html#<key>
%   name     = {...},
%   position = {MS Student},
%   photo    = {group_profile/<key>.jpg},
%   url      = {https://...},      optional personal site
%   aliases  = {Other Spelling},   optional, ";"-separated: other spellings in papers
