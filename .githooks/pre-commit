#!/usr/bin/env bash
#
# Check data/ and optimize any image being committed.
#
# Enable with:  tools/setup-hooks.sh
# Bypass once:  git commit --no-verify
#
# 1. tools/build.py --check validates every database in data/ (file names,
#    required fields, missing photos), so a broken entry never reaches main.
# 2. Photos are resized, re-encoded and stripped of EXIF before they enter git
#    history, so the repository never stores a 10MB camera original. Rules live
#    in tools/optimize-images.sh. Gallery thumbnails are made by the build and
#    are not committed.
#
# Written for the bash 3.2 that ships with macOS.

set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO"

if ! python3 tools/build.py --check >/dev/null; then
    python3 tools/build.py --check || true
    echo "pre-commit: fix the data errors above, or commit anyway with --no-verify" >&2
    exit 1
fi

# Staged images in the directories the optimizer manages.
STAGED=()
while IFS= read -r path; do
    STAGED+=("$path")
done < <(
    git diff --cached --name-only --diff-filter=ACMR \
    | grep -Ei '^(data/gallery/photos|data/members/photos|data/research/icons|static/lab_photo)/.*\.(jpe?g|png)$' || true
)

[ "${#STAGED[@]}" -gt 0 ] || exit 0

if ! command -v convert >/dev/null 2>&1; then
    cat >&2 <<'EOF'

  This commit adds images, but ImageMagick is not installed so they cannot be
  optimized. Unoptimized camera photos bloat the repository permanently.

    Ubuntu/Debian : sudo apt install imagemagick
    macOS         : brew install imagemagick

  To commit anyway: git commit --no-verify

EOF
    exit 1
fi

# Files that name images. Remember their state so we stage only the ones the
# optimizer rewrites (when an image changes extension), not unrelated edits.
REFS="data/gallery/gallery.yaml data/members/members.yaml data/research/topics.yaml pages/index.html"
BEFORE="$(for f in $REFS; do [ -f "$f" ] && echo "$f $(git hash-object "$f")"; done)"

echo "pre-commit: optimizing ${#STAGED[@]} image(s)..."
tools/optimize-images.sh "${STAGED[@]}"

# Re-stage each image: it may have been shrunk in place, or renamed to .jpg.
for path in "${STAGED[@]}"; do
    if [ -f "$path" ]; then
        git add -- "$path"
    else
        renamed="${path%.*}.jpg"
        if [ -f "$renamed" ]; then
            git add -- "$renamed"
            git rm --cached --quiet --ignore-unmatch -- "$path"
        fi
    fi
done

for f in $REFS; do
    [ -f "$f" ] || continue
    if [ "$(echo "$BEFORE" | awk -v f="$f" '$1 == f { print $2 }')" != "$(git hash-object "$f")" ]; then
        git add -- "$f"
        echo "  staged rewritten references in $f"
    fi
done
